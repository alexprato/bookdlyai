# Copy this file to .env.local and fill in to enable real LLM answers for off-script
# chat questions. Without this key, off-script questions return a friendly canned reply.
ANTHROPIC_API_KEY=

# Optional: forward captured chat leads to a webhook URL.
# Works with GoHighLevel, APCC, Make.com, Zapier, n8n, or any endpoint that
# accepts POST application/json. Leave empty to log leads server-side during
# development.
LEAD_WEBHOOK_URL=
